{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":automergeMinor",
    ":prHourlyLimitNone",
    ":disableDependencyDashboard"
  ],
  "rangeStrategy": "replace",
  "automergeType": "branch",
  "packageRules": [
    {
      "matchPackageNames": [
        "postgres"
      ],
      "allowedVersions": "<= 14"
    }
  ],
  "vulnerabilityAlerts": {
    "assignees": ["@Tbaile"]
  }
}
