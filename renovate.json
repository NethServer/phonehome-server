{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":automergeMinor",
    ":prHourlyLimitNone",
    ":disableDependencyDashboard"
  ],
  "ignorePresets": [
    ":pinDevDependencies",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "rangeStrategy": "replace",
  "automergeType": "branch",
  "packageRules": [
    {
      "matchPackageNames": [
        "postgres"
      ],
      "allowedVersions": "<= 14"
    },
    {
      "matchPackageNames": [
        "php"
      ],
      "separateMinorPatch": true
    }
  ],
  "vulnerabilityAlerts": {
    "assignees": ["@Tbaile"]
  }
}
